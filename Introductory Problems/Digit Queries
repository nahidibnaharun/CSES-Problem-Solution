void solve()
{
    ll n;
    cin >> n;

    ll len = 1, cnt = 9, start = 1;

    while (n > len * cnt) {
        n -= len * cnt;
        len++;
        cnt *= 10;
        start *= 10;
    }

    ll num = start + (n - 1) / len;
    ll idx = (n - 1) % len;

    cout << to_string(num)[idx] << '\n';
}

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    ll t;
    cin >> t;

    while(t--){
        solve();
    }

    return 0;
}
