vector<string>chess(8);
int ans=0;

int queen[8];
void permutation(int i ){
    if(i==8){
        ans++;
        return;
    }

    for (int j = 0; j < 8; j++) {
        if (chess[i][j] == '*') continue;

        bool ok = true;

        for (int r = 0; r < i; r++) {
            if (queen[r] == j ||
                abs(i - r) == abs(j - queen[r])) {
                ok = false;
                break;
            }
        }

        if (ok) {
            queen[i] = j;
            permutation(i + 1);
        }
    }

}
