void solve()
{
    int n; cin >> n;
    ll total=0;
    vector<ll>a(n);
    for(auto &x:a){
        cin >> x; total+=x;
    }

    ll ans=LLONG_MAX;

    for(int mask=0; mask<(1<<n); mask++){
        ll sum=0;

        for(int i=0;i<n;i++){
            if(mask & (1<<i)){
                sum+=a[i];
            }
        }
        ans=min(ans,abs(total-2*sum));
    }
    cout<<ans;

    


}

