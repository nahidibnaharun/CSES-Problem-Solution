void solve(){
    string s; cin >> s; int n= s.size(); vector<int>hash(26,0); for(auto &x:s)hash[x-'A']++;
    int mx=*max_element(hash.begin() , hash.end());

    if(mx > ((n+1)/2)){
        cout<<-1;return;
    }

    string ans="";
    int prev=-1;

    for(int pos=0; pos<n; pos++){

        for(int i=0 ;i<26; i++){
            if(hash[i]==0 || i==prev)continue;

            hash[i]--;
            int Nn= n-pos-1 , mxel=*max_element(hash.begin() , hash.end());

            if( mxel <= (Nn+1)/2 ){
                ans+=(i+'A');
                prev=i;
                break;
            }
            hash[i]++;
        }
    }
    cout<<ans;
}




