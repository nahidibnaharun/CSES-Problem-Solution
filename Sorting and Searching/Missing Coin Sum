void solve(){
int n;
    cin >> n;

    vector<ll> a(n);

    for (auto &x : a) cin >> x;

    sort(a.begin(), a.end());

    ll ans = 1;

    for (int i = 0; i < n; i++) {
        if (a[i] > ans) {
            break;
        }

        ans += a[i];
    }

    cout << ans ;

}




