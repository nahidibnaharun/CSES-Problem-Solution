void solve(){
    int n; cin >> n;
    vector<int> v(n);
    for(auto &x:v)cin >> x;

    unordered_set<int> st;
    st.reserve(n);

    int left=0;
    ll ans=0;

    for(int right=0;right<n;right++){
        while(st.count(v[right])){
            st.erase(v[left]);left++;
        }
        st.insert(v[right]);
        ans+=right-left+1;
    }
    cout<<ans;


}
 
 
 
