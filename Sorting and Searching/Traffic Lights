void solve(){
set<int> positions;
multiset<int> length;

int x,n; cin >> x >> n;

length.insert(x);
positions.insert(0); positions.insert(x);

for(int i=0 ;i<n;i++){
    int l; cin >> l;
    auto it= positions.lower_bound(l);
    int right=*it;
    int left=*prev(it);
    length.erase(length.find(right-left));
    positions.insert(l);
    length.insert(l-left); length.insert(right-l);

    cout<<*length.rbegin()<<" ";
}


}
 
 
 
