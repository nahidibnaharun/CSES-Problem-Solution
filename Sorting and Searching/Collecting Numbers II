void solve(){
    int n,k; cin >> n >> k;
    vector<int>ar(n+1,0),ext(n+1,0);
    for(int i=1;i<=n;i++){
        int x; cin >> x;
        ar[x]=i;
        ext[i]=x;
    }

    int ans=1;

    for(int i=1;i<n;i++){
        if(ar[i]>ar[i+1])ans++;
    }

    while(k--){
        int a,b; cin >> a >> b;
        int extra=0;

        a=ext[a]; b=ext[b];
        extra=a;
        a=min(a,b); b= max(extra,b);
        extra=0;
        if(a>1){
            if(ar[a-1]>ar[a])extra++;
        }
        if(a<n){
            if(ar[a]>ar[a+1])extra++;
        }
        if(b>1 && a!=b-1){
            if(ar[b-1]>ar[b])extra++;
        }
        if(b<n){
            if(ar[b]>ar[b+1])extra++;
        }
        ans-=extra;
        extra=0;
        swap(ar[a],ar[b]);
        swap(ext[ar[a]],ext[ar[b]]);
        if(a>1){
            if(ar[a-1]>ar[a])extra++;
        }
        
        if(a<n){
            if(ar[a]>ar[a+1])extra++;
        }
        if(b>1 && a!=b-1){
            if(ar[b-1]>ar[b])extra++;
        }
        if(b<n){
            if(ar[b]>ar[b+1])extra++;
        }
        ans+=extra;
        cout<<ans<<endl;

    }
    

}



