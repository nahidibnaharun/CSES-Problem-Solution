void solve(){
    int n; cin >> n;
    
    unordered_map<int, int> hash;
    hash.reserve(n);
    vector<int>a(n); for(auto &x:a)cin >> x;

    int ans=0,i=0,j=0;


    while(i<n && j<n){
        if(hash.find(a[j])==hash.end()){
            hash[a[j]]++;
            ans=max(ans,(j-i+1));
            j++;
        }
        else{
            hash.erase(a[i]);
            i++;
        }
        
    }
    cout<<ans;
}



