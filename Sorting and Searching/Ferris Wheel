void solve(){
    ll n,x;cin>>n>>x;
    vector<int>a(n);for(auto &x:a)cin>>x;
    sort(a.begin(),a.end());
    int ans=0;
    int i=0,j=n-1;
    while(i<=j){
        ans++;
        if(i==j)break;
        if(a[i]+a[j]<=x){i++;j--;}
        else j--;
    }

}




